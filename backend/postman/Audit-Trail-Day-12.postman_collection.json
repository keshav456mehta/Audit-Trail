{
  "info": {
    "name": "Audit Trail - Day 12 POST Move Tests",
    "description": "Run Valid request followed immediately by Duplicate event to verify duplicate rejection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "1. Valid request",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"aggregateId\": \"day12-valid\",\n  \"eventType\": \"ShipmentCreated\",\n  \"payload\": { \"origin\": \"Chennai\" }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/shipment/move"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 201', () => pm.response.to.have.status(201));"] } }]
    },
    {
      "name": "2. Missing aggregateId",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"ShipmentCreated\",\n  \"payload\": {}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/shipment/move"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "3. Wrong aggregateId type",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"aggregateId\": 123,\n  \"eventType\": \"ShipmentCreated\",\n  \"payload\": {}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/shipment/move"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "4. Missing payload",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"aggregateId\": \"day12-no-payload\",\n  \"eventType\": \"ShipmentCreated\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/shipment/move"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "5. Duplicate event (run after Valid request)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"aggregateId\": \"day12-valid\",\n  \"eventType\": \"ShipmentCreated\",\n  \"payload\": { \"origin\": \"Chennai\" }\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/shipment/move"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 409', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "6. Invalid eventType",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"aggregateId\": \"day12-invalid-type\",\n  \"eventType\": \"ShipmentCancelled\",\n  \"payload\": {}\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/shipment/move"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 400', () => pm.response.to.have.status(400));"] } }]
    }
  ]
}
