# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.
# At least 32 random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Passwords for the seeded accounts (docker compose run --rm backend node scripts/seed.js)
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_PASSWORD=
